{
  "plugins": [
    "react",
    "import"
  ],
  "rules": {
    "react/forbid-elements": [
      "warn",
      {
        "forbid": []
      }
    ],
    "no-restricted-imports": [
      "warn",
      {
        "patterns": [
          {
            "group": [
              "components/asistente/**",
              "components/base/**",
              "components/chips/**",
              "components/datos/**",
              "components/marca/**",
              "components/navegacion/**",
              "components/registros/**",
              "ui_kits/hotelero-escritorio/**",
              "ui_kits/hotelero-movil/**"
            ],
            "message": "Import design-system components from 'index.js', not component internals."
          }
        ]
      }
    ],
    "no-restricted-syntax": [
      "warn",
      {
        "selector": "Literal[value=/#[0-9a-fA-F]{3,8}\\b/]",
        "message": "Raw hex color — use a design-system color token via var()."
      },
      {
        "selector": "Literal[value=/\\b\\d+px\\b/]",
        "message": "Raw px value — use a design-system spacing token via var()."
      },
      {
        "selector": "Literal[value=/font-family\\s*:\\s*(?!['\\\"]?(?:Schibsted Grotesk))/i]",
        "message": "Font not provided by the design system. Available: Schibsted Grotesk."
      },
      {
        "selector": "JSXOpeningElement[name.name='Ambiente'] > JSXAttribute > JSXIdentifier[name!=/^(?:tema|key|ref|className|style|children)$/]",
        "message": "<Ambiente> doesn't accept that prop. Declared props: tema."
      },
      {
        "selector": "JSXOpeningElement[name.name='Ambiente'] > JSXAttribute[name.name='tema'] > Literal[value!=/^(?:dia|tarde|noche)$/]",
        "message": "<Ambiente> tema must be one of 'dia' | 'tarde' | 'noche'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Aviso'] > JSXAttribute > JSXIdentifier[name!=/^(?:dot|accion|resuelto|children|key|ref|className|style|children)$/]",
        "message": "<Aviso> doesn't accept that prop. Declared props: dot, accion, resuelto, children."
      },
      {
        "selector": "JSXOpeningElement[name.name='AvisoMientrasDormias'] > JSXAttribute > JSXIdentifier[name!=/^(?:resumen|titulo|children|key|ref|className|style|children)$/]",
        "message": "<AvisoMientrasDormias> doesn't accept that prop. Declared props: resumen, titulo, children."
      },
      {
        "selector": "JSXOpeningElement[name.name='Badge'] > JSXAttribute > JSXIdentifier[name!=/^(?:variant|children|key|ref|className|style|children)$/]",
        "message": "<Badge> doesn't accept that prop. Declared props: variant, children."
      },
      {
        "selector": "JSXOpeningElement[name.name='Badge'] > JSXAttribute[name.name='variant'] > Literal[value!=/^(?:conteo|tonal|outline)$/]",
        "message": "<Badge> variant must be one of 'conteo' | 'tonal' | 'outline'."
      },
      {
        "selector": "JSXOpeningElement[name.name='BotonAtender'] > JSXAttribute > JSXIdentifier[name!=/^(?:ambar|children|key|ref|className|style|children)$/]",
        "message": "<BotonAtender> doesn't accept that prop. Declared props: ambar, children."
      },
      {
        "selector": "JSXOpeningElement[name.name='BotonesResolver'] > JSXAttribute > JSXIdentifier[name!=/^(?:onSi|onNo|key|ref|className|style|children)$/]",
        "message": "<BotonesResolver> doesn't accept that prop. Declared props: onSi, onNo."
      },
      {
        "selector": "JSXOpeningElement[name.name='Burbuja'] > JSXAttribute > JSXIdentifier[name!=/^(?:de|hora|children|key|ref|className|style|children)$/]",
        "message": "<Burbuja> doesn't accept that prop. Declared props: de, hora, children."
      },
