        "selector": "JSXOpeningElement[name.name='Burbuja'] > JSXAttribute[name.name='de'] > Literal[value!=/^(?:usuario|asistente)$/]",
        "message": "<Burbuja> de must be one of 'usuario' | 'asistente'."
